# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Development Settings
VITE_USE_FIREBASE_EMULATORS=false

# Optional App Check (reCAPTCHA Enterprise site key). Leave empty to disable.
VITE_APPCHECK_SITE_KEY=
# Local only: "true" or a registered debug token for App Check-enforced projects.
# VITE_APPCHECK_DEBUG_TOKEN=

# Emulator overrides (defaults shown)
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_EMULATOR_AUTH_PORT=9099
# VITE_EMULATOR_DATABASE_PORT=9000
# VITE_EMULATOR_FIRESTORE_PORT=8080
