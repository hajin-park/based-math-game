rules_version = '2';

// Schema (see src/data/index.ts):
//   users/{uid}                          profile + settings      (owner; registered accounts write)
//   users/{uid}/runs/{runId}             run history             (owner; create-only, no updates)
//   userStats/{uid}                      aggregates + bests      (owner; registered accounts write)
//   leaderboards/{modeId}/entries/{uid}  best ranked result      (public read; owner write if improved)
//
// Guests are Firebase anonymous users. They keep runs/settings in localStorage
// and never write Firestore; their data is imported when they upgrade.
//
// Limits mirror SCORE_LIMITS (src/game/scoring.ts), the format constants
// (src/game/formats.ts) and RULES_LIMITS (src/data/limits.ts).
// src/data/limits.test.ts fails if these numbers drift apart.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Registered = signed in with a real provider (not anonymous).
    function isRegistered() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isNum(v) {
      return v is int || v is float;
    }

    function numIn(v, lo, hi) {
      return isNum(v) && v >= lo && v <= hi;
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }

    // ---- limits ----
    function maxCorrectPerSecond() { return 3; }        // SCORE_LIMITS.maxCorrectPerSecond
    function minMsPerCorrect() { return 250; }          // SCORE_LIMITS.minMsPerCorrect
    function maxDurationMs() { return 3600000; }        // SCORE_LIMITS.maxDurationMs
    function sprintMaxCorrect() { return 180; }         // SCORE_LIMITS.sprintMaxCorrect
    function speedrunMinMs() { return 3750; }           // SCORE_LIMITS.speedrunMinMs
    function dailyMinMs() { return 2500; }              // SCORE_LIMITS.dailyMinMs
    function survivalMaxCleared() { return 1000; }      // SCORE_LIMITS.survivalMaxCleared
    function sprintMs() { return 60000; }               // SPRINT_DURATION_MS
    function sprintToleranceMs() { return 2000; }       // RULES_LIMITS.sprintToleranceMs
    function speedrunTarget() { return 15; }            // SPEEDRUN_TARGET
    function speedrunSkipMs() { return 5000; }          // SPEEDRUN_SKIP_PENALTY_MS
    function dailyQuestions() { return 10; }            // DAILY_QUESTION_COUNT
    function dailySkipMs() { return 10000; }            // DAILY_SKIP_PENALTY_MS
    function maxCount() { return 10000; }               // RULES_LIMITS.maxCorrect
    function maxRunMs() { return 21600000; }            // stored runs (practice is untimed): 6 h
    function maxRunScore() { return 1000000000; }

    // ---- profiles ----
    function validSettings(s) {
      return s is map && s.size() <= 32;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'createdAt', 'settings'])
        && (!('displayName' in d) || validName(d.displayName))
        && (!('settings' in d) || validSettings(d.settings));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isRegistered()
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && isRegistered()
        && validProfile(request.resource.data)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      // ---- run history ----
      function validRun(d) {
        return d.keys().hasOnly(['modeId', 'topicId', 'format', 'score', 'correct', 'skipped',
                                 'durationMs', 'accuracy', 'typingAccuracy', 'endedAt', 'completed'])
          && d.keys().hasAll(['modeId', 'topicId', 'format', 'score', 'correct', 'skipped',
                              'durationMs', 'accuracy', 'typingAccuracy', 'endedAt'])
          && d.modeId is string && d.modeId.size() >= 1 && d.modeId.size() <= 64
          && d.topicId is string && d.topicId.size() >= 1 && d.topicId.size() <= 32
          && d.format in ['sprint', 'speedrun', 'survival', 'daily', 'practice']
          && numIn(d.score, 0, maxRunScore())
          && intIn(d.correct, 0, maxCount())
          && intIn(d.skipped, 0, maxCount())
          && numIn(d.durationMs, 0, maxRunMs())
          && numIn(d.accuracy, 0, 1)
          && numIn(d.typingAccuracy, 0, 1)
          && numIn(d.endedAt, 0, request.time.toMillis() + 300000)
          && (!('completed' in d) || d.completed is bool)
          // At most 3 correct answers per second (one free answer for tiny runs).
          && d.correct * 1000 <= d.durationMs * maxCorrectPerSecond() + 1000;
      }

      match /runs/{runId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isRegistered()
          && validRun(request.resource.data);
      }
    }

    // ---- aggregates ----
    function validStats(d) {
      return d.keys().hasOnly(['gamesPlayed', 'totalCorrect', 'totalDurationMs', 'lastPlayedAt', 'bests'])
        && d.keys().hasAll(['gamesPlayed', 'totalCorrect', 'totalDurationMs', 'lastPlayedAt', 'bests'])
        && d.gamesPlayed is int && d.gamesPlayed >= 0
        && d.totalCorrect is int && d.totalCorrect >= 0
        && isNum(d.totalDurationMs) && d.totalDurationMs >= 0
        && isNum(d.lastPlayedAt)
        && d.bests is map && d.bests.size() <= 1000;
    }

    match /userStats/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && isRegistered()
        && validStats(request.resource.data);
      allow update: if isOwner(uid) && isRegistered()
        && validStats(request.resource.data)
        && request.resource.data.gamesPlayed >= resource.data.gamesPlayed;
    }

    // ---- leaderboards ----
    // Ranked ids (engine isRankedModeId / RANKED_MODE_RE in src/data/limits.ts):
    //   `${topic}:sprint`, `${topic}:speedrun`, `survival`, `daily:YYYY-MM-DD`.
    function isRankedMode(modeId) {
      return modeId.matches('^((nibbles|powers|bytes-bin|bytes-hex|octal|words|twos|bitwise|binary-add|applied|mixed):(sprint|speedrun)|survival|daily:[0-9]{4}-[0-9]{2}-[0-9]{2})$');
    }

    function isDaily(modeId) {
      return modeId.matches('^daily:.*');
    }

    function isSpeedrun(modeId) {
      return modeId.matches('.*:speedrun$');
    }

    function isSprint(modeId) {
      return modeId.matches('.*:sprint$');
    }

    function lowerIsBetter(modeId) {
      return isDaily(modeId) || isSpeedrun(modeId);
    }

    // Per-format plausibility (see SCORE_LIMITS in src/game/scoring.ts).
    function plausible(modeId, d) {
      return d.correct * 1000 <= d.durationMs * maxCorrectPerSecond() + 1000
        && d.durationMs >= d.correct * minMsPerCorrect()
        && (isSprint(modeId)
              ? (d.score == d.correct
                 && d.score <= sprintMaxCorrect()
                 && d.durationMs >= sprintMs() - sprintToleranceMs()
                 && d.durationMs <= sprintMs() + sprintToleranceMs())
          : isSpeedrun(modeId)
              ? (d.correct == speedrunTarget()
                 && d.score == d.durationMs + d.skipped * speedrunSkipMs()
                 && d.score >= speedrunMinMs())
          : isDaily(modeId)
              ? (d.correct + d.skipped <= dailyQuestions()
                 && d.score == d.durationMs + d.skipped * dailySkipMs()
                 && d.score >= dailyMinMs())
          // survival
              : (d.score == d.correct && d.score <= survivalMaxCleared()));
    }

    function validEntry(modeId, uid, d) {
      return d.keys().hasOnly(['uid', 'displayName', 'score', 'correct', 'skipped', 'durationMs',
                               'accuracy', 'completed', 'updatedAt'])
        && d.keys().hasAll(['uid', 'displayName', 'score', 'correct', 'skipped', 'durationMs',
                            'accuracy', 'completed', 'updatedAt'])
        && d.uid == uid
        && validName(d.displayName)
        && d.completed == true
        && isNum(d.score) && d.score >= 0
        && intIn(d.correct, 0, maxCount())
        && intIn(d.skipped, 0, maxCount())
        && numIn(d.durationMs, 1, maxDurationMs())
        && numIn(d.accuracy, 0, 1)
        && d.updatedAt == request.time
        && plausible(modeId, d);
    }

    function improves(modeId, next, prev) {
      return lowerIsBetter(modeId) ? next.score < prev.score : next.score > prev.score;
    }

    // Display-name propagation: only the name changes (rank/tie-break kept).
    function nameOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validName(request.resource.data.displayName);
    }

    match /leaderboards/{modeId}/entries/{uid} {
      allow get: if true;
      // Pages of at most 100 (count() aggregations are denied too, so a
      // player's rank is computed from a bounded "who is ahead" query).
      allow list: if request.query.limit <= 100;
      allow create: if isOwner(uid) && isRegistered() && isRankedMode(modeId)
        && validEntry(modeId, uid, request.resource.data);
      allow update: if isOwner(uid) && isRegistered() && isRankedMode(modeId)
        && (nameOnlyUpdate()
            || (!isDaily(modeId)   // daily: one ranked attempt per day
                && validEntry(modeId, uid, request.resource.data)
                && improves(modeId, request.resource.data, resource.data)));
      allow delete: if isOwner(uid);
    }
  }
}
